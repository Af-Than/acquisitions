{
  "name": "acquisitions",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "imports": {
    "#config/*": "./src/config/*",
    "#controllers/*": "./src/controllers/*",
    "#middleware/*": "./src/middleware/*",
    "#models/*": "./src/models/*",
    "#routes/*": "./src/routes/*",
    "#services/*": "./src/services/*",
    "#utils/*": "./src/utils/*",
    "#vali/*": "./src/validations/*"
  },
  "homepage": "https://github.com/Af-Than/acquisitions#readme",
  "bugs": {
    "url": "https://github.com/Af-Than/acquisitions/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Af-Than/acquisitions.git"
  },
  "license": "ISC",
  "author": "",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "docker:dev": "docker compose -f docker-compose.dev.yml --env-file .env.development up --build",
    "docker:dev:down": "docker compose -f docker-compose.dev.yml down",
    "docker:prod": "docker compose -f docker-compose.prod.yml --env-file .env.production up --build",
    "docker:prod:down": "docker compose -f docker-compose.prod.yml down",
    "test:traffic": "python web_traffic_simulator/api_traffic_tester.py",
    "test:traffic:burst": "python web_traffic_simulator/api_traffic_tester.py 20 --burst"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "nodemon": "^3.1.11",
    "prettier": "^3.9.9"
  },
  "dependencies": {
    "@arcjet/inspect": "^1.14.1",
    "@arcjet/node": "^1.14.1",
    "@neondatabase/serverless": "^1.1.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.4",
    "drizzle-orm": "^0.45.3",
    "express": "^5.1.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.1",
    "winston": "^3.19.0",
    "zod": "^4.6.5"
  }
}
